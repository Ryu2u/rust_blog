SERVER_IP=127.0.0.1
SERVER_PORT=9002
DATABASE_URL=mysql://user:password@localhost:3306/rust_blog?charset=utf8mb4
BLOG_ORIGIN=http://localhost:8088
ADMIN_ORIGIN=http://localhost:8089
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=12
# ---- 登录防护（均有默认值，可不设置）----
LOGIN_MAX_FAIL_PER_IP=10
LOGIN_MAX_FAIL_PER_USER_IP=5
LOGIN_MAX_FAIL_PER_USER=30
LOGIN_WINDOW_MIN=15
LOGIN_LOCK_MIN=15
# 部署在 Nginx 等反向代理后面时设为 true（读取 X-Forwarded-For 最右一项）；
# 未经代理直连时务必保持 false，否则该请求头可被伪造来绕过限频
TRUST_PROXY_HEADER=false
# 登录 Cookie 加 Secure 属性（上 HTTPS 时设为 true）
COOKIE_SECURE=false
# ---- GitHub 笔记同步 ----
NOTE_SYNC_ENABLED=true
NOTE_SYNC_REPO=owner/repo
NOTE_SYNC_BRANCH=
NOTE_SYNC_TOKEN=github_pat_xxx
NOTE_SYNC_INTERVAL_MIN=30
NOTE_SYNC_ROOT=笔记/
NOTE_SYNC_EXCLUDE_DIRS=.obsidian,.trash
NOTE_SYNC_AUTHOR=your-name
NOTE_SYNC_CATEGORY=笔记
NOTE_SYNC_MAX_FILE_KB=1024
# openssl rand -base64 32
NOTE_SYNC_AI_ENC_KEY=
NOTE_SYNC_AI_ALLOW_HTTP=0
# ---- 说说 ↔ 仓库「说说/」目录 双向同步（需要 NOTE_SYNC_ENABLED=true）----
# 仓库内的说说目录；留空 = 关闭说说同步
NOTE_SYNC_MOMENT_DIR=说说/
# false / 0 = 只从仓库拉取，不把后台的改动写回仓库。写回需要令牌有 Contents 读写权限；
# 第一次上线建议先设 false 观察一轮，确认「认领 / 新建」符合预期后再改成 true
NOTE_SYNC_MOMENT_PUSH=true
# 仅供本地用模拟 GitHub 做测试；非 https 只允许 localhost / 127.0.0.1 / [::1]。正常使用请留空
NOTE_SYNC_API_BASE=

# ---- 说说图片上传到腾讯云 COS（浏览器直传，后端只发临时授权）----
# 前四项缺任意一个、桶名不是 <名称>-<APPID> 的形式、或 COS_UPLOAD_PREFIX 非法，上传功能就关闭
# （后台发不了新图片，已有图片不受影响），启动日志会说明原因。
# SecretId / SecretKey 用 CAM 子账号的永久密钥，且只授予 sts:GetFederationToken 与
# moment/* 的 name/cos:PutObject，见 docs/migrations/2026-11-04-moment-image-cos-upload.md
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=examplebucket-1250000000
COS_REGION=ap-nanjing
# 存进说说的图片地址前缀，可填 CDN / 自定义域名；留空 = https://<桶>.cos.<地域>.myqcloud.com
COS_PUBLIC_BASE=
# 对象键前缀，也是后台校验「新增图片地址」的前缀（只允许 A-Za-z0-9._/-）；要和 CAM 策略里的路径一致
COS_UPLOAD_PREFIX=moment/
# 单张图片上限（MB）；预签名上传链接的有效期（秒，最大 1800）
COS_MAX_IMAGE_MB=5
COS_SIGN_EXPIRE_SECS=300
# 仅供本地用模拟 STS / COS 做测试；非 https 只允许 localhost / 127.0.0.1 / [::1]。正常使用请留空
COS_STS_ENDPOINT=
COS_UPLOAD_BASE=
